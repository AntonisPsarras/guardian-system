# Template for esphome/secrets.yaml.
#
# DO NOT hand-copy this file. Run:
#
#     python tools/guardian-gen-secrets.py
#
# It writes esphome/secrets.yaml, asks only for the things it cannot know (your
# Wi-Fi and your LAN addresses), and generates every key and password with the
# `secrets` module. Copying this file by hand and filling in the obvious fields
# is how installs end up running on the placeholder values below - which for
# guardian_rfid_mac_key is a real compromise, not an untidiness. See its note.
#
# secrets.yaml itself is gitignored and must never be committed.
#
# These are exactly the keys referenced by portal-unit.yaml and
# doorbell-unit.yaml. No key here is optional: a missing one is a build-time
# failure, not a runtime one.
#
# Leaving a placeholder in place is caught in two different ways, because
# ESPHome can only catch one of them. guardian_rfid_mac_key is validated by
# components/guardian_rfid/__init__.py and a template value fails the BUILD. The
# passwords are just strings to ESPHome, so nothing there can object - those are
# caught by `python tools/guardian-preflight.py`, which fails if any PLACEHOLDER
# survives into secrets.yaml. Run it before you flash.

# --- Shared ---
wifi_ssid: "PLACEHOLDER-your-network-name"
wifi_password: "PLACEHOLDER-your-network-password"

# --- Interior portal (ESP32-S3) ---
# encryption_key is base64 of 32 random bytes and must DIFFER between the two
# devices - one leaked key should not read the other device's API traffic.
portal_unit__encryption_key: "PLACEHOLDER-base64-32-bytes"
portal_unit__ota_password: "PLACEHOLDER-random-ota-password"
portal_unit__ap_ssid: "Portal Fallback"
portal_unit__ap_password: "PLACEHOLDER-random-ap-password"

# --- Doorbell (Xiao ESP32-C6) ---
doorbell_unit__encryption_key: "PLACEHOLDER-base64-32-bytes"
doorbell_unit__ota_password: "PLACEHOLDER-random-ota-password"
doorbell_unit__fallback_password: "PLACEHOLDER-random-ap-password"

# The address reserved for the doorbell in the router's DHCP table. Used as
# wifi.use_address so that Home Assistant reaches the device by IP rather than
# by mDNS name - see the comment in doorbell-unit.yaml. The device still gets
# its address from DHCP; this is only where Home Assistant looks for it, so the
# reservation and this value must agree.
doorbell_unit__ip: "192.168.0.50"

# Interior portal static LAN. Replace all four with your own values in
# secrets.yaml. The address must sit OUTSIDE the router's DHCP pool, since the
# portal claims it statically rather than leasing it. Never put your real
# addresses in this example file — it is the one file here that IS committed.
portal_unit__ip: "192.168.0.40"
portal_unit__gateway: "192.168.0.1"
portal_unit__subnet: "255.255.255.0"
portal_unit__dns: "192.168.0.1"

# 32-byte HMAC key, 64 hex characters. SAME value on both devices. Generate
# with: python -c "import secrets; print(secrets.token_hex(32))"
#
# This used to read 64 zeros, which is 64 valid hex characters and therefore
# BUILT AND RAN. Anyone who copied this file and filled in the fields that
# obviously demanded it - Wi-Fi, addresses - got a working system whose entire
# card scheme was keyed on a value published in this repository. The value below
# is deliberately not hex so that leaving it fails the build instead, and
# validate_master_key now also rejects any single repeated byte.
#
# Changing this invalidates every enrolled card, and for MIFARE Classic keys
# that is now stronger than "re-enroll them". Every card credential is derived
# from this value: the NTAG password, and the Classic sector keys that replace
# the factory FFFFFFFFFFFF on first use. Rotate this and an already-upgraded
# Classic card is locked with a key nothing on the new install can derive.
# KEEP THE OLD VALUE if you ever rotate: putting it back is the only easy way
# to reach those cards again. NTAG21x cards are recoverable either way.
guardian_rfid_mac_key: "PLACEHOLDER-run-tools/guardian-gen-secrets.py-to-generate-this"
